# Qwen3-ASR private gateway
HOST=127.0.0.1
PORT=8010
QWEN_GATEWAY_API_KEY=
QWEN_ASR_MODEL_ID=Qwen/Qwen3-ASR-1.7B
QWEN_ALIGN_MODEL_ID=Qwen/Qwen3-ForcedAligner-0.6B
# Set these to two independent, complete Hugging Face snapshots. Do not point
# them at the existing D:\短视频\model directory unless it has been verified as
# a complete Qwen snapshot; that directory currently contains Whisper files.
QWEN_ASR_MODEL_PATH=D:\短视频\model\qwen3-asr-1.7b
QWEN_ALIGN_MODEL_PATH=D:\短视频\model\qwen3-forced-aligner-0.6b
QWEN_DEVICE_MAP=auto
QWEN_DTYPE=float16
QWEN_MAX_INFERENCE_BATCH_SIZE=1
QWEN_MAX_NEW_TOKENS=256
QWEN_MAX_UPLOAD_BYTES=134217728

