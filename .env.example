# Local production baseline. External model calls are optional.
DEMO_MODE=true
PORT=8787
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
DATA_ROOT=./data
DATABASE_FILE=./data/washcut.sqlite
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
WORKER_CONCURRENCY=1
VIDEO_ANALYSIS_CONCURRENCY=1
VIDEO_PART_SIZE_BYTES=8388608
VIDEO_IMPORT_MAX_BYTES=262144000
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Automatic video orchestration worker. The project and per-asset limits are
# independent so that multiple videos can be analyzed without overloading ffmpeg.
AUTO_VIDEO_WORKER_CONCURRENCY=1
AUTO_VIDEO_ASSET_CONCURRENCY=2
AUTO_VIDEO_VISUAL_MAX_RETRIES=2

# Independent Speaches (OpenAI-compatible) transcription service. Leave the
# base URL empty only for the explicitly labelled DEMO_MODE=true local fallback.
SPEACHES_BASE_URL=
SPEACHES_API_KEY=
SPEACHES_MODEL=Systran/faster-whisper-large-v3
SPEACHES_TIMEOUT_MS=600000
SPEACHES_MAX_RETRIES=2
# Speaches loads Whisper on the first transcription request. The app explicitly
# unloads it through /api/ps when switching away; no app-side TTL is required.

# Set DEMO_MODE=false to enable the structured vision/creative relay.
RELAY_BASE_URL=https://relay.example.com
RELAY_API_KEY=
RELAY_MODEL=gpt-5

# Optional explicit media binaries. By default the app discovers Remotion's bundled binaries.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional private Qwen ASR gateway. Qwen stays disabled until both the ASR and
# forced-aligner health checks report the exact configured models as ready.
# Do not expose this gateway to the browser or public internet.
QWEN_ASR_BASE_URL=http://127.0.0.1:8010
# Leave blank to use QWEN_ASR_BASE_URL for the aligner endpoint as well.
QWEN_ALIGN_BASE_URL=
QWEN_ASR_API_KEY=
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ALIGN_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
QWEN_ASR_TIMEOUT_MS=600000
QWEN_ASR_MAX_RETRIES=2
QWEN_ASR_VOCABULARY_PROFILE=car-wash-zh-v1
