# Local production baseline. External model calls are optional.
DEMO_MODE=true
PORT=8787
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
# Optional public-testing gateway. Point Cloudflare Tunnel at this port, never
# at Vite or PORT. Leave WASHCUT_TEST_ACCESS_CODE empty to keep it disabled.
WASHCUT_TEST_PORT=8790
# Local administrator dashboard; never use this port as the Tunnel target.
WASHCUT_TEST_ADMIN_PORT=8791
WASHCUT_TEST_ACCESS_CODE=
WASHCUT_TEST_VISUAL_CONCURRENCY=1
WASHCUT_TEST_MAX_UPLOAD_BYTES=1048576000
WASHCUT_INTERNAL_API_URL=http://127.0.0.1:8787
DATA_ROOT=./data
DATABASE_FILE=./data/washcut.sqlite
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
WORKER_CONCURRENCY=1
VIDEO_ANALYSIS_CONCURRENCY=1
VIDEO_PART_SIZE_BYTES=8388608
VIDEO_IMPORT_MAX_BYTES=262144000
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Automatic video orchestration worker. The project and per-asset limits are
# independent so that multiple videos can be analyzed without overloading ffmpeg.
AUTO_VIDEO_WORKER_CONCURRENCY=1
AUTO_VIDEO_ASSET_CONCURRENCY=2
# Process-wide limits shared by every active generation. Both must be integers
# from 1 to 30; per-generation visual concurrency is additionally capped by
# these limits. Media preparation, Qwen ASR and Remotion keep separate limits.
AUTO_VIDEO_VISUAL_GLOBAL_CONCURRENCY=30
AUTO_VIDEO_MODEL_CONCURRENCY=30
AUTO_VIDEO_VISUAL_MAX_RETRIES=2

# Set DEMO_MODE=false to enable the structured vision/creative relay.
RELAY_BASE_URL=https://relay.example.com
RELAY_API_KEY=
RELAY_MODEL=gpt-5
# Relay stream budgets: wait for the first byte, then allow a bounded gap
# between chunks, while keeping a hard cap on one complete response.
RELAY_FIRST_BYTE_TIMEOUT_MS=120000
RELAY_IDLE_TIMEOUT_MS=30000
RELAY_TOTAL_TIMEOUT_MS=180000
# Streamed response hard limits (bytes), selected by call type.
RELAY_MAX_SCREENSHOT_BYTES=4194304
RELAY_MAX_ASSET_BYTES=8388608
RELAY_MAX_PLAN_BYTES=16777216
RELAY_MAX_RESPONSE_BYTES=16777216

# Optional explicit media binaries. By default the app discovers Remotion's bundled binaries.
FFMPEG_PATH=
FFPROBE_PATH=

# Required private Qwen ASR gateway. The launcher loads Qwen automatically after
# Docker is confirmed available and both model snapshots report healthy.
# Do not expose this gateway to the browser or public internet.
QWEN_ASR_BASE_URL=http://127.0.0.1:8010
# Leave blank to use QWEN_ASR_BASE_URL for the aligner endpoint as well.
QWEN_ALIGN_BASE_URL=
QWEN_ASR_API_KEY=
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ALIGN_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
QWEN_ASR_TIMEOUT_MS=600000
QWEN_ASR_MAX_RETRIES=2
# Versioned server-side Qwen context. car-wash-zh-v1 remains the legacy no-context profile.
QWEN_ASR_VOCABULARY_PROFILE=car-wash-ad-zh-v2
# The main app starts this local gateway when the Qwen button is clicked.
# Override only when the gateway virtual environment is elsewhere.
QWEN_GATEWAY_DIR=./qwen3-asr-gateway
QWEN_GATEWAY_PYTHON=
QWEN_GATEWAY_START_TIMEOUT_MS=30000
