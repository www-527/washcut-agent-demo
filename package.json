{
  "name": "washcut-agent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx src/server/index.ts",
    "test": "tsx --test src/server/*.test.ts",
    "remotion:studio": "remotion studio src/remotion/index.ts --no-open",
    "render:demo": "remotion render src/remotion/index.ts WashcutMarketingVideo out/washcut-demo.mp4"
  },
  "dependencies": {
    "@remotion/captions": "4.0.507",
    "@remotion/media": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@remotion/transitions": "4.0.507",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.507",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  },
  "packageManager": "pnpm@11.16.0"
}
